OPTIONS (SKIP=1, ROWS=5000, BINDSIZE=20000000, READSIZE=20000000, ERRORS=0)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE 'csv/17_ETABLISSEMENT_NON_CLASSE.csv'
APPEND INTO TABLE ETABLISSEMENT_NON_CLASSE
FIELDS TERMINATED BY ';' OPTIONALLY ENCLOSED BY '"' TRAILING NULLCOLS
(
  idEtablissement,
  typeNonClasse CHAR(120),
  nbEtoilesDeclarees,
  nbChambres,
  nbLits
)
