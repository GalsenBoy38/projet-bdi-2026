                <task classkmad="tache.Task" id-task-point="K50" idkmad="K51">
                    <task-name>Vérifier la cohérence Pass / capacité et ajouter au panier</task-name>
                    <task-numero>1.4.2</task-numero>
                    <task-observation>Démarre le délai de validité de 15 minutes de la sélection dans le panier</task-observation>
                    <task-executant>SYS</task-executant>
                    <task-modality>COGN</task-modality>
                    <task-optional>false</task-optional>
                    <task-interruptible>false</task-interruptible>
                    <task-decomposition>LEAF</task-decomposition>
                    <task-precondition>(getValue($SelectionEnCours, $nbPass) &gt; 0) AND (getValue($SelectionEnCours, $nbPass) &lt;= getValue($SelectionEnCours, $passDisponibles)) AND (getValue($SelectionEnCours, $capaciteTotale) &gt;= getValue($SelectionEnCours, $nbPass))</task-precondition>
                    <task-descriptionprecondition>Nombre de Pass compris entre 1 et le nombre de Pass disponibles, et capacité totale des hébergements suffisante (réservation groupée obligatoire)</task-descriptionprecondition>
                    <task-effetsdebord>void</task-effetsdebord>
                    <task-iteration>[1]</task-iteration>
                    <point classkmad="tache.Point" idkmad="K50">
                        <point-x>4680</point-x>
                        <point-y>690</point-y>
                    </point>
                </task>
