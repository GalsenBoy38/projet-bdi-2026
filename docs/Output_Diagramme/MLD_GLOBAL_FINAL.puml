@startuml MLD_GLOBAL_FINAL
' =============================================================================
'  FestiBed - Groupe 3 - MLD GLOBAL FINAL
'  GÉNÉRÉ par docs/JPA_modelisation/3_peuplement_donnees/generer_mld.py depuis schema_festibed.py :
'  ne pas modifier à la main (modifier le schéma puis relancer le script).
'  Clé primaire soulignée, # clé étrangère, <<UK>> unicité, [0..1] = peut être NULL.
'  Couleur : vert = données publiques, bleu = mixtes, jaune = synthétiques.
'  Héritages JOINED : UTILISATEUR, UTILISATEUR_BACKOFFICE, ETABLISSEMENT (clé primaire = clé étrangère).
'  ETABLISSEMENT : classement/dateClassement/classementProroge tous NULL (non classé, OSM) ou tous
'  renseignés (classé) ; exactement une ligne dans l'une des 7 sous-tables.
' =============================================================================
hide circle
hide methods
hide stereotype
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam defaultFontSize 16
skinparam class {
  FontSize 18
  FontStyle bold
  AttributeFontSize 16
  BorderColor #555555
  ArrowColor black
}

' ===== Utilisateurs =====
entity "UTILISATEUR" as Utilisateur #FFEB9C {
  <u>idUtilisateur</u> : UUID
  --
  nom : VARCHAR(100)
  <<UK>> email : VARCHAR(150)
}

entity "FESTIVALIER" as Festivalier #FFEB9C {
  <u>#idUtilisateur</u> : UUID
  --
  fournisseurAuth : VARCHAR(30) [0..1]
  identifiantExterneFestivalier : VARCHAR(100) [0..1]
  <<UK>> (fournisseurAuth, identifiantExterneFestivalier)
}

entity "UTILISATEUR_BACKOFFICE" as UtilisateurBackoffice #FFEB9C {
  <u>#idUtilisateur</u> : UUID
  --
  motDePasseHache : VARCHAR(100)
}

entity "ORGANISATEUR" as Organisateur #FFEB9C {
  <u>#idUtilisateur</u> : UUID
  --
}

entity "HEBERGEUR" as Hebergeur #FFEB9C {
  <u>#idUtilisateur</u> : UUID
  --
}

' ===== Géographie =====
entity "REGION" as Region #C6EFCE {
  <u>idRegion</u> : UUID
  --
  <<UK>> nomRegion : VARCHAR(30)
}

entity "DEPARTEMENT" as Departement #C6EFCE {
  <u>codeDepartement</u> : VARCHAR(3)
  --
  nomDepartement : VARCHAR(50)
  #idRegion : UUID
}

entity "COMMUNE" as Commune #C6EFCE {
  <u>codeInsee</u> : VARCHAR(5)
  --
  nomCommune : VARCHAR(40)
  latitude : DECIMAL(12,9) [0..1]
  longitude : DECIMAL(12,9) [0..1]
  #codeDepartement : VARCHAR(3)
}

' ===== Festivals =====
entity "FESTIVAL" as Festival #BDD7EE {
  <u>idFestival</u> : UUID
  --
  nomFestival : VARCHAR(100)
  domaine : VARCHAR(40)
  sousDomaine : VARCHAR(70) [0..1]
  periodicite : VARCHAR(30) [0..1]
  moisDebut : SMALLINT
  siteWebFestival : VARCHAR(150) [0..1]
  numIdentification : VARCHAR(50) [0..1]
  dateCreation : DATE [0..1]
  codePostalFestival : VARCHAR(5)
  dateDebutAncien : DATE [0..1]
  dateFinAncien : DATE [0..1]
  dateDebutFestival : DATE
  dateFinFestival : DATE
  quotaPass : INT
  nbPassVendus : INT
  prixPass : DECIMAL(8,2)
  actifFestival : LOGICAL
  #codeInsee : VARCHAR(5)
  #idOrganisateur : UUID [0..1]
}

entity "NOTATION_FESTIVAL" as NotationFestival #FFEB9C {
  <u>#idFestival</u> : UUID
  <u>#idUtilisateur</u> : UUID
  --
  noteFestival : SMALLINT
  dateNoteFestival : DATE
}

' ===== Établissements =====
entity "ETABLISSEMENT" as Etablissement #BDD7EE {
  <u>idEtablissement</u> : UUID
  --
  nomCommercial : VARCHAR(100)
  adresse : VARCHAR(80) [0..1]
  codePostalEtablissement : VARCHAR(5)
  nomCommuneEtablissement : VARCHAR(50)
  #codeInsee : VARCHAR(5) [0..1]
  telephoneEtablissement : VARCHAR(30) [0..1]
  emailEtablissement : VARCHAR(150) [0..1]
  siteWebEtablissement : VARCHAR(350) [0..1]
  capaciteAccueil : INT
  classement : VARCHAR(50) [0..1]
  dateClassement : DATE [0..1]
  classementProroge : LOGICAL [0..1]
  latitudeEtablissement : DECIMAL(12,9) [0..1]
  longitudeEtablissement : DECIMAL(12,9) [0..1]
  <<UK>> osmRef : VARCHAR(25) [0..1]
  noteMoyenne : DECIMAL(3,2) [0..1]
  nbNotes : INT
  #idUtilisateur : UUID [0..1]
}

entity "HOTEL_DE_TOURISME" as HotelDeTourisme #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  nbChambresHotel : INT
}

entity "AUBERGE_COLLECTIVE" as AubergeCollective #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  nbChambresAuberge : INT
}

entity "CAMPING" as Camping #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  categorie : VARCHAR(10) [0..1]
  nbEmplacementsCamping : INT
}

entity "PARC_RESIDENTIEL_DE_LOISIRS" as ParcResidentielDeLoisirs #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  nbEmplacementsParc : INT
}

entity "VILLAGE_DE_VACANCES" as VillageDeVacances #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  mention : VARCHAR(30) [0..1]
  typeSejour : VARCHAR(30) [0..1]
  nbLogements : INT
}

entity "RESIDENCE_DE_TOURISME" as ResidenceDeTourisme #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  nbUnitesHabitation : INT
}

entity "ETABLISSEMENT_NON_CLASSE" as EtablissementNonClasse #C6EFCE {
  <u>#idEtablissement</u> : UUID
  --
  typeNonClasse : VARCHAR(30)
  nbEtoilesDeclarees : SMALLINT [0..1]
  nbChambres : INT [0..1]
  nbLits : INT [0..1]
}

entity "NOTATION_ETABLISSEMENT" as NotationEtablissement #FFEB9C {
  <u>#idEtablissement</u> : UUID
  <u>#idUtilisateur</u> : UUID
  --
  noteEtablissement : SMALLINT
  dateNoteEtablissement : DATE
}

' ===== Hébergements =====
entity "HEBERGEMENT" as Hebergement #FFEB9C {
  <u>#idEtablissement</u> : UUID
  <u>numeroHebergement</u> : VARCHAR(10)
  --
  typeHebergement : VARCHAR(30)
  capaciteHebergement : INT
  prixNuitHebergement : DECIMAL(8,2)
  descriptionHebergement : VARCHAR(500) [0..1]
  actifHebergement : LOGICAL
}

entity "PHOTO_HEBERGEMENT" as PhotoHebergement #FFEB9C {
  <u>idPhotoHebergement</u> : UUID
  --
  urlPhotoHebergement : VARCHAR(300)
  #idEtablissement : UUID
  #numeroHebergement : VARCHAR(10)
}

entity "OPTION_HEBERGEMENT" as OptionHebergement #FFEB9C {
  <u>idOptionHebergement</u> : UUID
  --
  <<UK>> libelleOptionHebergement : VARCHAR(50)
}

entity "EQUIPEMENT" as Equipement #FFEB9C {
  <u>#idEtablissement</u> : UUID
  <u>#numeroHebergement</u> : VARCHAR(10)
  <u>#idOptionHebergement</u> : UUID
  --
}

entity "NUITEE" as Nuitee #FFEB9C {
  <u>#idEtablissement</u> : UUID
  <u>#numeroHebergement</u> : VARCHAR(10)
  <u>dateNuitee</u> : DATE
  --
  prixNuitee : DECIMAL(8,2)
  #idSelection : UUID [0..1]
}

' ===== Réservations =====
entity "RESERVATION" as Reservation #FFEB9C {
  <u>numeroReservation</u> : VARCHAR(20)
  --
  dateReservation : DATETIME
  #idUtilisateur : UUID
}

entity "SELECTION" as Selection #FFEB9C {
  <u>idSelection</u> : UUID
  --
  prixPassSelection : DECIMAL(8,2)
  statutSelection : VARCHAR(20)
  #numeroReservation : VARCHAR(20)
  #idFestival : UUID
  <<UK>> (numeroReservation, idFestival)
}

entity "PASS" as Pass #FFEB9C {
  <u>idPass</u> : UUID
  --
  <<UK>> codePass : VARCHAR(40)
  #idSelection : UUID
}

entity "PAIEMENT" as Paiement #FFEB9C {
  <u>idPaiement</u> : UUID
  --
  <<UK>> numTransaction : VARCHAR(30) [0..1]
  montantPaiement : DECIMAL(10,2)
  datePaiement : DATETIME [0..1]
  statutPaiement : VARCHAR(20)
  <<UK>> #numeroReservation : VARCHAR(20)
}

' ===== Clés étrangères (table référencée -- table qui référence) =====
Region -- Departement
Departement -- Commune
Utilisateur -- Festivalier
Utilisateur -- UtilisateurBackoffice
UtilisateurBackoffice -- Organisateur
UtilisateurBackoffice -- Hebergeur
Commune -- Festival
Organisateur -- Festival
Commune -- Etablissement
Hebergeur -- Etablissement
Etablissement -- HotelDeTourisme
Etablissement -- AubergeCollective
Etablissement -- Camping
Etablissement -- ParcResidentielDeLoisirs
Etablissement -- VillageDeVacances
Etablissement -- ResidenceDeTourisme
Etablissement -- EtablissementNonClasse
Etablissement -- Hebergement
Hebergement -- PhotoHebergement
Hebergement -- Equipement
OptionHebergement -- Equipement
Festivalier -- Reservation
Reservation -- Paiement
Reservation -- Selection
Festival -- Selection
Selection -- Pass
Hebergement -- Nuitee
Selection -- Nuitee
Festival -- NotationFestival
Festivalier -- NotationFestival
Etablissement -- NotationEtablissement
Festivalier -- NotationEtablissement
@enduml
