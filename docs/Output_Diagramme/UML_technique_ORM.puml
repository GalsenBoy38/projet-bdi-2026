@startuml UML_technique_ORM
' =============================================================================
'  FestiBed - Groupe 3 - UML technique (modèle ORM / JPA)
'  Reflète les entités Kotlin de docs/JPA_modelisation/1_entites_jpa (03/11/2026) :
'   - Héritages JOINED : Utilisateur, UtilisateurBackoffice, Etablissement
'     (6 typologies classées + EtablissementNonClasse issu d'OpenStreetMap).
'   - Relations UNIDIRECTIONNELLES (flèche = sens de navigation) : pas de
'     collections inverses ; @OneToMany seulement pour les compositions.
'   - Compositions (losange plein, cascade ALL + orphanRemoval) :
'     Reservation ◆ Selection ◆ Pass, Hebergement ◆ PhotoHebergement.
'   - Clés techniques en UUID (@GeneratedValue(strategy = GenerationType.UUID),
'     Oracle RAW(16), H2 UUID) ; clés composées en @EmbeddedId (+ @MapsId).
'   - Festival.nbPassVendus et Etablissement.noteMoyenne / nbNotes : lecture
'     seule pour JPA, modifiés par UPDATE atomiques (stratégie de concurrence).
'   - Nuitee.selection = null -> nuitée libre.
'   - Etablissement : classement / dateClassement / classementProroge
'     renseignés pour les classés, NULL pour les non classés.
' =============================================================================

!define CONCRETE_COLOR #FFF9C4

skinparam classBackgroundColor CONCRETE_COLOR
skinparam classArrowColor black
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam defaultFontSize 16
skinparam titleFontSize 22
skinparam noteFontSize 15
hide empty methods

skinparam class {
    FontSize 18
    FontStyle bold
    AttributeFontSize 16
    BackgroundColor CONCRETE_COLOR
    BorderColor black
    ArrowColor black
}

title Diagramme UML technique - FestiBed (modèle ORM / JPA)

' ====== UTILISATEURS ======
abstract class Utilisateur {
    - id: UUID
    - nom: String
    - email: String
}

class Festivalier {
    - fournisseurAuth: String [0..1]
    - identifiantExterneFestivalier: String [0..1]
}

abstract class UtilisateurBackoffice {
    - motDePasseHache: String
}

class Organisateur
class Hebergeur

' ====== GEOGRAPHIE ======
class Region {
    - id: UUID
    - nomRegion: String
}

class Departement {
    - codeDepartement: String
    - nomDepartement: String
}

class Commune {
    - codeInsee: String
    - nomCommune: String
    - latitude: BigDecimal [0..1]
    - longitude: BigDecimal [0..1]
}

' ====== FESTIVALS ======
class Festival {
    - id: UUID
    - nomFestival: String
    - domaine: Domaine
    - sousDomaine: SousDomaine [0..1]
    - periodicite: Periodicite [0..1]
    - moisDebut: Int
    - siteWebFestival: String [0..1]
    - numIdentification: String [0..1]
    - dateCreation: LocalDate [0..1]
    - codePostalFestival: String
    - dateDebutAncien: LocalDate [0..1]
    - dateFinAncien: LocalDate [0..1]
    - dateDebutFestival: LocalDate
    - dateFinFestival: LocalDate
    - quotaPass: Int
    - nbPassVendus: Int {readOnly}
    - prixPass: BigDecimal
    - actifFestival: Boolean
    --
    + passDisponibles: Int
}

class NotationFestival {
    - id: NotationFestivalId
    - noteFestival: Int
    - dateNoteFestival: LocalDate
}

class NotationFestivalId <<Embeddable>> {
    - idFestival: UUID
    - idUtilisateur: UUID
}

' ====== ETABLISSEMENTS ======
abstract class Etablissement {
    - id: UUID
    - nomCommercial: String
    - adresse: String [0..1]
    - codePostalEtablissement: String
    - nomCommuneEtablissement: String
    - telephoneEtablissement: String [0..1]
    - emailEtablissement: String [0..1]
    - siteWebEtablissement: String [0..1]
    - capaciteAccueil: Int
    - classement: Classement [0..1]
    - dateClassement: LocalDate [0..1]
    - classementProroge: Boolean [0..1]
    - latitudeEtablissement: BigDecimal [0..1]
    - longitudeEtablissement: BigDecimal [0..1]
    - osmRef: String [0..1]
    - noteMoyenne: BigDecimal [0..1] {readOnly}
    - nbNotes: Int {readOnly}
    --
    + estClasse: Boolean
}

class HotelDeTourisme {
    - nbChambresHotel: Int
}

class AubergeCollective {
    - nbChambresAuberge: Int
}

class Camping {
    - categorie: CategorieCamping [0..1]
    - nbEmplacementsCamping: Int
}

class ParcResidentielDeLoisirs {
    - nbEmplacementsParc: Int
}

class VillageDeVacances {
    - mention: MentionVillage [0..1]
    - typeSejour: TypeSejour [0..1]
    - nbLogements: Int
}

class ResidenceDeTourisme {
    - nbUnitesHabitation: Int
}

class EtablissementNonClasse {
    - typeNonClasse: TypeNonClasse
    - nbEtoilesDeclarees: Int [0..1]
    - nbChambres: Int [0..1]
    - nbLits: Int [0..1]
}

class NotationEtablissement {
    - id: NotationEtablissementId
    - noteEtablissement: Int
    - dateNoteEtablissement: LocalDate
}

class NotationEtablissementId <<Embeddable>> {
    - idEtablissement: UUID
    - idUtilisateur: UUID
}

' ====== HEBERGEMENTS ======
class Hebergement {
    - id: HebergementId
    - typeHebergement: TypeHebergement
    - capaciteHebergement: Int
    - prixNuitHebergement: BigDecimal
    - descriptionHebergement: String [0..1]
    - actifHebergement: Boolean
}

class HebergementId <<Embeddable>> {
    - idEtablissement: UUID
    - numeroHebergement: String
}

class Nuitee {
    - id: NuiteeId
    - prixNuitee: BigDecimal
    --
    + libre: Boolean
}

class NuiteeId <<Embeddable>> {
    - hebergementId: HebergementId
    - dateNuitee: LocalDate
}

class PhotoHebergement {
    - id: UUID
    - urlPhotoHebergement: String
}

class OptionHebergement {
    - id: UUID
    - libelleOptionHebergement: String
}

' ====== RESERVATIONS ======
class Reservation {
    - numeroReservation: String
    - dateReservation: LocalDateTime
}

class Selection {
    - id: UUID
    - prixPassSelection: BigDecimal
    - statutSelection: StatutSelection
}

class Pass {
    - id: UUID
    - codePass: String
}

class Paiement {
    - id: UUID
    - numTransaction: String [0..1]
    - montantPaiement: BigDecimal
    - datePaiement: LocalDateTime [0..1]
    - statutPaiement: StatutPaiement
}

' ====== ENUMERATIONS ======
enum Domaine {
    MUSIQUES_ACTUELLES
    CINEMA_ET_AUDIOVISUEL
    MUSIQUES_CLASSIQUES
    CIRQUE_ET_ARTS_DE_LA_RUE
    LIVRE_ET_LITTERATURE
    DANSE
    THEATRE
    ARTS_PLASTIQUES_ET_VISUELS
    PLURIDISCIPLINAIRE_SPECTACLE_VIVANT
    PLURIDISCIPLINAIRE_MUSIQUE
    DIVERS_SPECTACLE_VIVANT
    TRANSDISCIPLINAIRE
    DOMAINES_DIVERS
}

enum SousDomaine {
    AMPLIFIEES_OU_ELECTRONIQUES
    JAZZ_BLUES_ET_IMPROVISEES
    CHANSON
    TRADITIONNELLES_ET_DU_MONDE
    BAROQUE_ET_ANCIEN
    ARTS_DE_LA_RUE
}

enum Periodicite {
    ANNUELLE
    BIENNALE_ANNEES_PAIRES
    BIENNALE_ANNEES_IMPAIRES
    BIANNUELLE
    IRREGULIERE
}

enum Classement {
    UNE_ETOILE
    DEUX_ETOILES
    TROIS_ETOILES
    QUATRE_ETOILES
    CINQ_ETOILES
    AUBERGE_COLLECTIVE
    AIRE_NATURELLE
}

enum CategorieCamping {
    TOURISME
    LOISIRS
}

enum MentionVillage {
    NON
    HEBERGEMENT_DISPERSE
    HEBERGEMENT_LEGER
    HEBERGEMENT_LEGER_ET_DISPERSE
}

enum TypeSejour {
    FORMULE_PENSION
    FORMULE_LOCATION
    FORMULE_LOCATION_PENSION
}

enum TypeNonClasse {
    HOTEL
    MOTEL
    CHAMBRE_D_HOTES
    GITE_CHALET
    APPARTEMENT
    AUBERGE_DE_JEUNESSE
    CAMPING
    AIRE_DE_CAMPING_CAR
    REFUGE_GARDE
}

enum TypeHebergement {
    CHAMBRE_SIMPLE
    CHAMBRE_DOUBLE
    EMPLACEMENT_DE_CAMPING
    BUNGALOW
    LOGEMENT_ENTIER
    LIT_EN_DORTOIR
}

enum StatutSelection {
    CONFIRMEE
    ANNULEE
}

enum StatutPaiement {
    NON_GERE
    EN_ATTENTE
    ACCEPTE
    REFUSE
    REMBOURSE
}

' ====== HERITAGE (JOINED) ======
UtilisateurBackoffice <|-- Organisateur
UtilisateurBackoffice --|> Utilisateur
UtilisateurBackoffice <|-- Hebergeur
Utilisateur <|-- Festivalier

HotelDeTourisme --|> Etablissement
AubergeCollective --|> Etablissement
Camping --|> Etablissement
ParcResidentielDeLoisirs --|> Etablissement
VillageDeVacances --|> Etablissement
ResidenceDeTourisme --|> Etablissement
EtablissementNonClasse --|> Etablissement

' ====== ORDRE GAUCHE -> DROITE (mise en page seulement) ======
Organisateur -[hidden]right- Utilisateur
Utilisateur -[hidden]right- Hebergeur
Hebergeur -[hidden]right- HotelDeTourisme
HotelDeTourisme -[hidden]right- AubergeCollective
AubergeCollective -[hidden]right- Camping
Camping -[hidden]right- ParcResidentielDeLoisirs
ParcResidentielDeLoisirs -[hidden]right- VillageDeVacances
VillageDeVacances -[hidden]right- ResidenceDeTourisme
ResidenceDeTourisme -[hidden]right- EtablissementNonClasse
Festival -[hidden]right- Festivalier
Festivalier -[hidden]right- Etablissement

' ====== RELATIONS (navigables dans le sens de la flèche) ======
Festival "0..*" --> "0..1" Organisateur : organisateur
Etablissement "0..*" --> "0..1" Hebergeur : hebergeur

Festival "0..*" --> "1" Commune : commune
Etablissement "0..*" --> "0..1" Commune : commune
Commune "0..*" --> "1" Departement : departement
Departement "0..*" --> "1" Region : region

NotationFestival "0..*" --> "1" Festival : festival
NotationFestival "0..*" --> "1" Festivalier : festivalier
NotationEtablissement "0..*" --> "1" Etablissement : etablissement
NotationEtablissement "0..*" --> "1" Festivalier : festivalier

Reservation "0..*" --> "1" Festivalier : festivalier
Reservation "1" *--> "1..*" Selection : selections
Selection "0..*" --> "1" Festival : festival
Selection "1" *--> "1..*" Pass : passes
Paiement "0..1" --> "1" Reservation : reservation

Hebergement "0..*" --> "1" Etablissement : etablissement
Hebergement "1" *--> "0..*" PhotoHebergement : photos
Hebergement "0..*" --> "0..*" OptionHebergement : options\n(EQUIPEMENT)
Nuitee "0..*" --> "1" Hebergement : hebergement
Nuitee "0..*" --> "0..1" Selection : selection

' ====== CLES COMPOSEES (@EmbeddedId) ======
NotationFestival *-- NotationFestivalId
NotationEtablissement *-- NotationEtablissementId
Hebergement *-- HebergementId
Nuitee *-- NuiteeId
NuiteeId ..> HebergementId

' ====== TYPES ENUMERES ======
Periodicite <.right. Festival
SousDomaine <.right. Festival
Domaine <.right. Festival
Etablissement .right.> Classement
CategorieCamping <.. Camping
TypeSejour <.. VillageDeVacances
MentionVillage <.. VillageDeVacances
TypeNonClasse <.. EtablissementNonClasse
Hebergement .right.> TypeHebergement
Selection ..> StatutSelection
Paiement ..> StatutPaiement

@enduml
