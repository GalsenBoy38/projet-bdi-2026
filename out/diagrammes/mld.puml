@startuml MLD_FestiBed
hide circle
hide methods
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 50
skinparam defaultFontSize 16
skinparam class {
  FontSize 18
  FontStyle bold
  AttributeFontSize 16
  BackgroundColor #FFFDE7
  BorderColor #555555
}
' Clé primaire soulignée, # clé étrangère, <<UK>> unicité, [0..1] = peut être NULL
' Longueurs des VARCHAR calées sur les valeurs max des jeux de données publics.

' ===== Utilisateurs =====
entity Utilisateur {
  <u>idUtilisateur</u> : INT
  --
  nom : VARCHAR(100)
  <<UK>> email : VARCHAR(150)
}

entity Festivalier {
  <u>#idUtilisateur</u> : INT
  --
  fournisseurAuth : VARCHAR(30) [0..1]
  identifiantExterneFestivalier : VARCHAR(100) [0..1]
  .. UK (fournisseurAuth, identifiantExterneFestivalier) ..
}

entity Utilisateur_backoffice {
  <u>#idUtilisateur</u> : INT
  --
  motDePasseHache : VARCHAR(100)
}

entity Organisateur {
  <u>#idUtilisateur</u> : INT
}

entity Hebergeur {
  <u>#idUtilisateur</u> : INT
}

' ===== Géographie =====
entity Region {
  <u>idRegion</u> : INT
  --
  nomRegion : VARCHAR(30)
}

entity Departement {
  <u>codeDepartement</u> : VARCHAR(3)
  --
  nomDepartement : VARCHAR(50)
  #idRegion : INT
}

entity Commune {
  <u>codeInsee</u> : VARCHAR(5)
  --
  nomCommune : VARCHAR(40)
  latitude : DECIMAL(12,9)
  longitude : DECIMAL(12,9)
  #codeDepartement : VARCHAR(3)
}

' ===== Festivals =====
entity Domaine {
  <u>idDomaine</u> : INT
  --
  libelleDomaine : VARCHAR(40)
}

entity Complement_domaine {
  <u>idComplementDomaine</u> : INT
  --
  libelleComplementDomaine : VARCHAR(70)
  #idDomaine : INT
}

entity Periodicite {
  <u>idPeriodicite</u> : INT
  --
  libellePeriodicite : VARCHAR(30)
}

entity Festival {
  <u>idFestival</u> : INT
  --
  nomFestival : VARCHAR(100)
  moisDebut : BYTE
  siteWebFestival : VARCHAR(150)
  numIdentification : VARCHAR(50)
  dateCreation : DATE
  codePostalFestival : VARCHAR(5)
  dateDebutAncien : DATE
  dateFinAncien : DATE
  dateDebutFestival : DATE
  dateFinFestival : DATE
  quotaPass : INT
  prixPass : DECIMAL(8,2)
  actifFestival : LOGICAL
  #idOrganisateur : INT [0..1]
  #codeInsee : VARCHAR(5)
  #idPeriodicite : INT [0..1]
  #idDomaine : INT
}

entity Notation_festival {
  <u>#idFestival</u> : INT
  <u>#idFestivalier</u> : INT
  --
  noteFestival : SMALLINT
  dateNoteFestival : DATE
}

' ===== Établissements =====
entity Classement {
  <u>idClassement</u> : INT
  --
  libelleClassement : VARCHAR(20)
}

entity Etablissement {
  <u>idEtablissement</u> : INT
  --
  dateClassement : DATE
  nomCommercial : VARCHAR(80)
  adresse : VARCHAR(80)
  codePostalEtablissement : VARCHAR(5)
  nomCommuneEtablissement : VARCHAR(50)
  siteWebEtablissement : VARCHAR(350)
  capaciteAccueil : INT
  classementProroge : LOGICAL
  #idHebergeur : INT [0..1]
  #idClassement : INT
}

entity Hotel_de_tourisme {
  <u>#idEtablissement</u> : INT
  --
  nbChambresHotel : INT
}

entity Auberge_collective {
  <u>#idEtablissement</u> : INT
  --
  nbChambresAuberge : INT
}

entity Camping {
  <u>#idEtablissement</u> : INT
  --
  categorie : VARCHAR(10)
  nbEmplacementsCamping : INT
}

entity Parc_residentiel_de_loisirs {
  <u>#idEtablissement</u> : INT
  --
  nbEmplacementsParc : INT
}

entity Village_de_vacances {
  <u>#idEtablissement</u> : INT
  --
  mention : VARCHAR(30)
  typeSejour : VARCHAR(30)
  nbLogements : INT
}

entity Residence_de_tourisme {
  <u>#idEtablissement</u> : INT
  --
  nbUnitesHabitation : INT
}

entity Notation_etablissement {
  <u>#idEtablissement</u> : INT
  <u>#idFestivalier</u> : INT
  --
  noteEtablissement : SMALLINT
  dateNoteEtablissement : DATE
}

' ===== Hébergements =====
entity Type_hebergement {
  <u>idTypeHebergement</u> : INT
  --
  libelleTypeHebergement : VARCHAR(50)
}

entity Hebergement {
  <u>idHebergement</u> : INT
  --
  capaciteHebergement : INT
  prixNuitHebergement : DECIMAL(8,2)
  descriptionHebergement : VARCHAR(500)
  actifHebergement : LOGICAL
  #idEtablissement : INT
  #idTypeHebergement : INT
}

entity Photo_hebergement {
  <u>idPhotoHebergement</u> : INT
  --
  urlPhotoHebergement : VARCHAR(300)
  #idHebergement : INT
}

entity Option_hebergement {
  <u>idOptionHebergement</u> : INT
  --
  libelleOptionHebergement : VARCHAR(50)
}

entity Equipement {
  <u>#idHebergement</u> : INT
  <u>#idOptionHebergement</u> : INT
}

' ===== Réservations =====
entity Reservation {
  <u>idReservation</u> : INT
  --
  dateReservation : DATETIME
  #idFestivalier : INT
}

entity Ligne_reservation {
  <u>idLigneReservation</u> : INT
  --
  prixPassLigneReservation : DECIMAL(8,2)
  statutLigneReservation : VARCHAR(20)
  #idFestival : INT
  #idReservation : INT
}

entity Pass {
  <u>idPass</u> : INT
  --
  <<UK>> codePass : VARCHAR(40)
  #idLigneReservation : INT
}

entity Nuitee {
  <u>idNuitee</u> : INT
  --
  dateNuitee : DATE
  prixNuitee : DECIMAL(8,2)
  #idLigneReservation : INT [0..1]
  #idHebergement : INT
  .. UK (idHebergement, dateNuitee) ..
}

entity Paiement {
  <u>idPaiement</u> : INT
  --
  montantPaiement : DECIMAL(10,2)
  datePaiement : DATETIME
  statutPaiement : VARCHAR(20)
  <<UK>> #idReservation : INT
}

' ===== Clés étrangères =====
' Écrites « table du dessus -- table du dessous » pour fixer la mise en page.

' Utilisateurs (haut)
Utilisateur_backoffice -- Organisateur
Utilisateur_backoffice -- Utilisateur
Utilisateur_backoffice -- Hebergeur
Utilisateur -- Festivalier

' Organisateur -> Festival (gauche), Hebergeur -> Etablissement (droite)
Organisateur -- Festival
Hotel_de_tourisme -- Etablissement
Auberge_collective -- Etablissement
Camping -- Etablissement
Parc_residentiel_de_loisirs -- Etablissement
Village_de_vacances -- Etablissement
Residence_de_tourisme -- Etablissement
Hebergeur -- Etablissement

' Référentiels du festival (à gauche)
Festival -- Commune
Commune -- Departement
Departement -- Region
Festival -- Periodicite
Complement_domaine -- Domaine
Festival -- Domaine

' Notations et réservation (au centre)
Festival -- Notation_festival
Festivalier -- Notation_festival
Festivalier -- Reservation
Festivalier -- Notation_etablissement
Etablissement -- Notation_etablissement
Etablissement -- Classement

Reservation -- Ligne_reservation
Festival -- Ligne_reservation
Reservation -- Paiement
Ligne_reservation -- Pass

' Hébergements (en bas à droite)
Etablissement -- Hebergement
Ligne_reservation -- Nuitee
Hebergement -- Nuitee
Hebergement -- Type_hebergement
Hebergement -- Photo_hebergement
Hebergement -- Equipement
Equipement -- Option_hebergement
@enduml
